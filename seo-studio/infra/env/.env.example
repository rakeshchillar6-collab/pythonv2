# --- Core Django Settings ---
SECRET_KEY=your-super-secret-key-for-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# For production, set this to your domain: ALLOWED_HOSTS=your-frontend-domain.com,your-api-domain.com

# --- Database ---
DATABASE_URL=postgres://user:password@db:5432/seo_studio

# --- Cache / Task Queue ---
REDIS_URL=redis://redis:6379/0

# --- Frontend Integration ---
# This is where your Next.js app is running
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT Settings (SimpleJWT) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Internationalization ---
LANGUAGE_CODE=fa-ir
TIME_ZONE=UTC

# --- Next.js Environment ---
# This is passed to the Next.js container
NEXT_PUBLIC_API_URL=http://localhost:8000/api
